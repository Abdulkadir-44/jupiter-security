---
import { Globe, Menu, X } from "lucide-react";
import Logo from "@/components/Logo.astro";
import { getSiteContent, localePath, otherLocales, telHref } from "@/lib/data";

const s = getSiteContent(Astro.currentLocale);
// Dil değiştirici: diğer dilin ana sayfasına gider (şimdilik tek sayfa olduğu için)
const langs = otherLocales(Astro.currentLocale).map((l) => ({
  href: localePath(l),
  short: getSiteContent(l).locale.short,
  lang: l,
}));
---

<!--
  Header davranışı (Super 8 referansı):
  Sayfa başında şeffaf ve tam genişlik. Aşağı kaydırınca ortada yüzen, yuvarlak
  köşeli, cam efektli bir şeride dönüşür; alttaki ince çizgi ortadan kapanır.
-->
<header id="site-header" data-compact="false" class="site-header fixed inset-x-0 top-0 z-50 px-2 md:px-3 lg:px-0">
  <div class="nav-bar mx-auto flex items-center justify-between gap-6">
    <a href="#top" aria-label={`${s.brand.fullName}, ${s.ui.backToTop}`} class="nav-logo rounded-md">
      <Logo />
    </a>

    <nav aria-label={s.ui.mainNav} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          s.nav.map((n) => (
            <li>
              <a href={n.href} class="nav-link">
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {
        langs.map((l) => (
          <a
            href={l.href}
            hreflang={l.lang}
            class="inline-flex h-11 items-center gap-1.5 rounded-full border border-paper/20 px-3.5 text-[13px] font-semibold tracking-wide text-paper transition-colors duration-200 hover:border-paper/50 hover:bg-paper/10"
          >
            <Globe className="size-4" strokeWidth={1.8} aria-hidden="true" />
            {l.short}
            <span class="sr-only">, {s.ui.switchLanguage}</span>
          </a>
        ))
      }
      <a href={telHref(s.contact)} class="nav-cta">
        <span>{s.hero.primaryCta}</span>
        <svg class="nav-cta-arrow size-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M4 10 10 4M5 4h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-11 cursor-pointer place-items-center rounded-full border border-paper/20 text-paper lg:hidden"
      >
        <span class="sr-only" data-label-open>{s.ui.menu}</span>
        <span class="sr-only hidden" data-label-close>{s.ui.close}</span>
        <Menu className="size-5" aria-hidden="true" data-icon-open />
        <X className="hidden size-5" aria-hidden="true" data-icon-close />
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="mx-auto mt-2 max-w-[1040px] rounded-[1.5rem] bg-navy/95 p-5 shadow-2xl ring-1 ring-paper/10 backdrop-blur-md lg:hidden">
    <nav aria-label={s.ui.mobileNav}>
      <ul class="grid">
        {
          s.nav.map((n) => (
            <li>
              <a href={n.href} class="block border-b border-paper/10 py-3.5 font-title text-[1.6rem]" data-close-menu>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={telHref(s.contact)}
        class="mt-5 flex min-h-12 items-center justify-center gap-2 rounded-full bg-teal font-semibold text-ink"
      >
        {s.ui.call}: <span class="tabular-nums">{s.contact.phoneDisplay}</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .nav-bar {
    position: relative;
    max-width: 80rem;
    height: 80px;
    margin-top: 0;
    padding-inline: 1.5rem;
    border-radius: 0;
    background-color: color-mix(in srgb, var(--color-navy) 0%, transparent);
    box-shadow:
      0 0 0 0 rgb(0 0 0 / 0),
      0 0 0 0 color-mix(in srgb, var(--color-paper) 0%, transparent);
    font-size: 15px;
  }
  @media (width >= 48rem) {
    .nav-bar {
      padding-inline: 2.5rem;
    }
  }

  /* Alt çizgi */
  .nav-bar::before {
    content: "";
    position: absolute;
    inset-inline: 1.5rem;
    bottom: 0;
    height: 1px;
    background: color-mix(in srgb, var(--color-paper) 20%, transparent);
    transform-origin: 50% 50%;
    pointer-events: none;
  }
  @media (width >= 48rem) {
    .nav-bar::before {
      inset-inline: 2.5rem;
    }
  }

  /* Geçişler sadece sayfa hazır olunca (ilk yüklemede zıplama olmasın) */
  .site-header[data-ready="true"] .nav-bar {
    transition:
      max-width 0.7s var(--ease-out-expo),
      height 0.55s var(--ease-out-expo),
      margin-top 0.55s var(--ease-out-expo),
      padding 0.55s var(--ease-out-expo),
      border-radius 0.55s var(--ease-out-expo),
      background-color 0.4s ease,
      box-shadow 0.4s ease,
      font-size 0.55s var(--ease-out-expo),
      backdrop-filter 0.2s ease;
  }
  .site-header[data-ready="true"] .nav-bar::before {
    transition:
      transform 0.4s var(--ease-in-out-quart) 0.35s,
      opacity 0.2s ease 0.35s;
  }

  /* Kompakt (yüzen) hal */
  .site-header[data-compact="true"] .nav-bar {
    max-width: 1040px;
    height: 60px;
    margin-top: 8px;
    padding-inline: 1.25rem 0.5rem;
    border-radius: 30px;
    background-color: color-mix(in srgb, var(--color-navy) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow:
      0 10px 30px -12px rgb(0 0 0 / 0.6),
      0 0 0 1px color-mix(in srgb, var(--color-paper) 10%, transparent);
    font-size: 13.5px;
  }
  @media (width >= 48rem) {
    .site-header[data-compact="true"] .nav-bar {
      height: 66px;
      margin-top: 12px;
      padding-inline: 1.75rem 0.75rem;
      border-radius: 33px;
    }
  }
  .site-header[data-compact="true"] .nav-bar::before {
    transform: scaleX(0);
    opacity: 0;
  }
  .site-header[data-ready="true"][data-compact="true"] .nav-bar::before {
    transition:
      transform 0.3s var(--ease-in-out-quart),
      opacity 0.2s ease 0.15s;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.85rem;
    font-size: 1rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-paper) 88%, transparent);
    transition: color 0.2s ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 0.85rem;
    bottom: 10px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out-expo);
  }
  .nav-link:hover {
    color: var(--color-paper);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-cta {
    display: none;
    align-items: center;
    gap: 6px;
    height: 42px;
    padding-inline: 0.5rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-paper);
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      padding 0.4s var(--ease-out-expo);
  }
  @media (width >= 40rem) {
    .nav-cta {
      display: inline-flex;
    }
  }
  .nav-cta-arrow {
    color: var(--color-teal);
    transition: transform 0.25s var(--ease-out-expo);
  }
  .nav-cta:hover .nav-cta-arrow {
    transform: translate(2px, -2px);
  }
  .site-header[data-compact="true"] .nav-cta {
    padding-inline: 1.125rem;
    background-color: var(--color-paper);
    color: var(--color-ink);
  }
  .site-header[data-compact="true"] .nav-cta-arrow {
    color: var(--color-teal-ink);
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  let menuOpen = false;

  const update = () => header.setAttribute("data-compact", String(menuOpen || window.scrollY > 40));
  update();
  requestAnimationFrame(() => requestAnimationFrame(() => header.setAttribute("data-ready", "true")));
  window.addEventListener("scroll", update, { passive: true });

  const setOpen = (open: boolean) => {
    menuOpen = open;
    toggle.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
    update();
    toggle.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
    toggle.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
    toggle.querySelector("[data-label-open]")?.classList.toggle("hidden", open);
    toggle.querySelector("[data-label-close]")?.classList.toggle("hidden", !open);
  };

  toggle.addEventListener("click", () => setOpen(!menuOpen));
  menu.querySelectorAll("[data-close-menu]").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuOpen) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
