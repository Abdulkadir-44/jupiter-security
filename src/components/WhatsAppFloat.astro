---
import { WhatsAppIcon } from "@/components/ui/BrandIcons";
import { getSiteContent, whatsappHref } from "@/lib/data";

const s = getSiteContent(Astro.currentLocale);
---

<a
  href={whatsappHref(s.contact)}
  target="_blank"
  rel="noopener"
  aria-label={s.ui.whatsappFloat}
  class="fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-40 grid size-14 place-items-center rounded-full bg-wa text-ink shadow-[0_8px_24px_-6px_rgb(0_0_0/0.55)] transition-transform duration-200 hover:scale-105 sm:right-6 sm:bottom-6"
>
  <WhatsAppIcon className="size-7" />
</a>
