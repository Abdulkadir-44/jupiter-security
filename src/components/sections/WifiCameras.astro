---
/**
 * Wi-Fi (kablosuz) kameralar. Güneş enerjili bölümle aynı düzen: solda metin, sağda fotoğraf slider kartı.
 * Vurgu rengi güneş enerjili bölümdeki gibi sarı (yeşil zeminde yeşil vurgu kayboluyordu); zemin farklı (panel değil, sayfa zemini).
 * ŞABLON: metin taslak, fotoğraflar `site.*.ts` → `wifi.slides` içine eklenecek.
 */
import { Wifi } from "lucide-react";
import PhotoSlider from "@/components/PhotoSlider.astro";
import PriceTag from "@/components/ui/PriceTag.astro";
import PlaceList from "@/components/ui/PlaceList.astro";
import StatusList from "@/components/ui/StatusList.astro";
import { WhatsAppIcon } from "@/components/ui/BrandIcons";
import { getSiteContent, whatsappHref } from "@/lib/data";

const s = getSiteContent(Astro.currentLocale);
const w = s.wifi;
---

<section id="wifi" aria-labelledby="wifi-baslik">
  <div class="wrap py-20 md:py-28">
    <!--
      Mobil: metin → slider → fiyat butonu ve not (tek sütun, sırayla).
      Masaüstü: solda metin ve altında fiyat butonu + not, sağda slider; sol grup dikeyde ortalanır.
    -->
    <div class="grid lg:grid-cols-[1fr_1.05fr] lg:grid-rows-[1fr_auto_auto_1fr] lg:gap-x-20">
      <!-- Metin -->
      <div class="lg:col-start-1 lg:row-start-2">
        <p class="inline-flex items-center gap-2.5 font-mono text-[12px] font-medium tracking-[0.14em] text-paper/80 uppercase md:text-[13px]">
          <span class="size-1.5 rounded-full bg-sun shadow-[0_0_10px_var(--color-sun)]" aria-hidden="true"></span>
          {w.eyebrow}
        </p>
        <h2 id="wifi-baslik" class="mt-4 font-title text-balance text-[clamp(2.6rem,6vw,4.75rem)]">{w.title}</h2>
        <p class="mt-6 max-w-[48ch] text-[1.1rem] text-mist">{w.lead}</p>

        <!-- Kurulum yerleri: Wi-Fi simgeli liste (buton görünümü yok) -->
        <PlaceList places={w.places} icon="wifi" accent="sun" />

        <!-- Özellikler: çevrimiçi ışığı: Wi-Fi'ye bağlanan kamera (tik yerine) -->
        <StatusList items={w.features} variant="ping" />
      </div>

      <!-- Sağ sütun (mobilde metnin altı): fotoğraf slider'ı -->
      <div class="mt-12 lg:col-start-2 lg:row-span-4 lg:row-start-1 lg:mt-0 lg:self-center">
        <PhotoSlider slides={w.slides} label={w.screenLabel} ariaLabel={w.eyebrow} accent="sun" />
      </div>

      <!-- Fiyat butonu ve not: mobilde slider'ın altında, masaüstünde sol sütunda metnin altında -->
      <div class="mt-9 flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-7 lg:col-start-1 lg:row-start-3 lg:mt-12">
        {
          w.priceTag ? (
            <PriceTag href={whatsappHref(s.contact, w.whatsappMessage)} {...w.priceTag} accent="sun" notch="var(--color-navy)" />
          ) : (
            <a
              href={whatsappHref(s.contact, w.whatsappMessage)}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-12 items-center justify-center gap-2.5 rounded-full bg-sun px-6 font-semibold whitespace-nowrap text-ink transition-[filter] duration-200 hover:brightness-110"
            >
              <WhatsAppIcon className="size-[1.1rem]" />
              {w.cta}
            </a>
          )
        }
        <p class="flex items-center gap-2 text-sm text-mist">
          <Wifi className="size-4 shrink-0 text-paper/60" aria-hidden="true" />
          {w.note}
        </p>
      </div>
    </div>
  </div>
</section>
