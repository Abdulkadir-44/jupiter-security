---
import { Image } from "astro:assets";
import { Icon } from "@/components/ui/Icon";
import { getSiteContent } from "@/lib/data";

const s = getSiteContent(Astro.currentLocale);
const w = s.work;
---

<section id="isler" aria-labelledby="isler-baslik" class="panel bg-ink">
  <div class="wrap py-20 md:py-28">
    <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr] lg:items-end lg:gap-20">
      <h2 id="isler-baslik" class="font-title text-balance text-[clamp(2.6rem,6vw,4.75rem)]">{w.title}</h2>
      <p class="max-w-[42ch] text-[1.1rem] text-mist">
        {w.lead}
        {w.allLink}: {s.ui.soon}.
      </p>
    </div>

    <!-- Kayıt cihazı çoklu ekran görünümü: gerçek kurulum fotoğrafları (fotoğrafı olmayan kare ikonlu yer tutucu) -->
    <ul class="mt-12 grid grid-cols-2 gap-2 md:mt-16 lg:grid-cols-3">
      {
        w.items.map((it) => (
          <li class="relative aspect-[4/3] overflow-hidden rounded-[0.9rem] bg-gradient-to-br from-navy-2 to-navy">
            {it.image && typeof it.image !== "string" ? (
              <Image
                src={it.image}
                alt={it.alt ?? it.place}
                widths={[360, 640, 960]}
                sizes="(min-width: 1024px) 400px, 50vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            ) : it.image ? (
              <img src={it.image} alt={it.alt ?? it.place} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
            ) : (
              <>
                <Icon
                  name={it.kind}
                  className="absolute top-1/2 left-1/2 size-[34%] -translate-x-1/2 -translate-y-1/2 text-paper/10"
                  strokeWidth={1}
                />
                <div class="scanlines absolute inset-0" aria-hidden="true" />
              </>
            )}
            <span class="absolute top-2.5 left-2.5 rounded bg-ink/70 px-1.5 py-0.5 font-mono text-[10px] text-paper/85 sm:top-3 sm:left-3 sm:text-xs" aria-hidden="true">
              {it.cam}
            </span>
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 via-ink/50 to-transparent px-3 pt-10 pb-2.5 sm:px-3.5 sm:pb-3">
              <p class="text-[13px] font-semibold leading-tight sm:text-base">{it.place}</p>
              {it.area && <p class="text-xs text-mist sm:text-sm">{it.area}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
