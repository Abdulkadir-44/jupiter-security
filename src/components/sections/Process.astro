---
import { Icon } from "@/components/ui/Icon";
import { getSiteContent } from "@/lib/data";

const p = getSiteContent(Astro.currentLocale).process;
---

<section id="surec" aria-labelledby="surec-baslik" class="panel bg-cream text-ink">
  <div class="wrap py-20 md:py-28">
    <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr] lg:items-end lg:gap-20">
      <h2 id="surec-baslik" class="font-title text-balance text-[clamp(2.6rem,6vw,4.75rem)]">{p.title}</h2>
      <p class="max-w-[42ch] text-[1.1rem] text-ink-soft">{p.lead}</p>
    </div>

    <!-- Adımlar gerçekten sıralı olduğu için numaralı -->
    <!--
      Mobil/tablet (lg altı): her adım ayrı kart, sırayla sola/sağa yatık ve kaydırılmış.
      Masaüstü (lg): eski düzen, 5 sütun ve ince ayırıcı çizgiler (max-lg: ile ayrıldı).
    -->
    <ol data-steps class="mt-14 grid gap-4 md:mt-20 lg:grid-cols-5 lg:gap-0 lg:border-t lg:border-ink/15">
      {
        p.steps.map((st, i) => (
          <li style={`--drop-rot:${i % 2 ? 10 : -10}deg`} class="grid grid-cols-[3.25rem_1fr] gap-x-4 max-lg:rounded-[1.25rem] max-lg:bg-paper max-lg:p-5 max-lg:shadow-[0_18px_36px_-22px_color-mix(in_srgb,var(--color-ink)_45%,transparent)] max-lg:ring-1 max-lg:ring-ink/10 max-lg:odd:mr-4 max-lg:odd:-rotate-[1.6deg] max-lg:even:ml-4 max-lg:even:rotate-[1.6deg] lg:block lg:border-l lg:border-ink/15 lg:px-6 lg:py-8 lg:first:border-l-0 lg:first:pl-0">
            <span class="font-tall text-[3rem] leading-none text-teal-ink lg:text-[4rem]">{i + 1}</span>
            <div class="lg:mt-8">
              <h3 class="flex items-center gap-2 text-[1.15rem] font-semibold">
                <Icon name={st.icon} className="size-[1.1rem] shrink-0 text-teal-ink" strokeWidth={2.2} />
                {st.title}
              </h3>
              <p class="mt-2 text-[0.98rem] text-ink-soft">{st.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /*
   * Mobil/tablet: kartlar kaydırınca yukarıdan düşüp yatık hâline yaylanarak oturur.
   * data-drop sadece JS çalışınca eklenir (JS yoksa kartlar normal görünür).
   */
  @media (width < 64rem) and (prefers-reduced-motion: no-preference) {
    [data-drop] > li {
      transition:
        translate 0.75s cubic-bezier(0.34, 1.56, 0.64, 1),
        rotate 0.75s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.3s ease-out;
    }
    [data-drop] > li:not(.is-in) {
      opacity: 0;
      translate: 0 -4rem;
      rotate: var(--drop-rot);
    }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>("[data-steps]");
  const mobile = matchMedia("(width < 64rem)").matches;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (list && mobile && !reduced && "IntersectionObserver" in window) {
    const cards = [...list.querySelectorAll<HTMLElement>(":scope > li")];
    // Sayfa açıldığında zaten geçilmiş (ekranın üstünde kalmış) kartları gizleme
    cards.forEach((c) => c.getBoundingClientRect().bottom < 0 && c.classList.add("is-in"));
    list.setAttribute("data-drop", "");

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -15% 0px", threshold: 0.2 },
    );
    cards.forEach((c) => io.observe(c));
  }
</script>
