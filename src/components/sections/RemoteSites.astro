---
/**
 * Elektrik ve internet olmayan yerler (bağ, bahçe, yayla, yazlık): güneş enerjili, SIM kartlı 4G kameralar.
 * Sol: metin, yer etiketleri, avantajlar, WhatsApp. Sağ: animasyonlu "sistem" kartı (manzara çizimi + 4 adımlık zincir).
 * Animasyonlar saf CSS (ekstra JavaScript yok); hareket azaltma açıksa durur.
 */
import { Check, Signal } from "lucide-react";
import { Icon } from "@/components/ui/Icon";
import { WhatsAppIcon } from "@/components/ui/BrandIcons";
import { getSiteContent, whatsappHref } from "@/lib/data";

const s = getSiteContent(Astro.currentLocale);
const r = s.remote;
---

<section id="arazi" aria-labelledby="arazi-baslik" class="panel bg-ink text-paper">
  <div class="wrap py-20 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-20">
      <!-- Metin -->
      <div>
        <p class="inline-flex items-center gap-2.5 font-mono text-[12px] font-medium tracking-[0.14em] text-paper/80 uppercase md:text-[13px]">
          <span class="size-1.5 rounded-full bg-sun shadow-[0_0_10px_var(--color-sun)]" aria-hidden="true"></span>
          {r.eyebrow}
        </p>
        <h2 id="arazi-baslik" class="mt-4 font-title text-balance text-[clamp(2.6rem,6vw,4.75rem)]">{r.title}</h2>
        <p class="mt-6 max-w-[48ch] text-[1.1rem] text-mist">{r.lead}</p>

        <ul class="mt-8 flex flex-wrap gap-2">
          {
            r.places.map((p) => (
              <li class="rounded-full border border-paper/15 bg-paper/[0.04] px-3.5 py-1.5 text-sm text-paper/90">{p}</li>
            ))
          }
        </ul>

        <ul class="mt-8 grid gap-3">
          {
            r.features.map((f) => (
              <li class="flex items-start gap-3">
                <Check className="mt-1 size-4 shrink-0 text-sun" strokeWidth={3} aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href={whatsappHref(s.contact, r.whatsappMessage)}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-12 items-center justify-center gap-2.5 rounded-full bg-sun px-6 font-semibold whitespace-nowrap text-ink transition-[filter] duration-200 hover:brightness-110"
          >
            <WhatsAppIcon className="size-[1.1rem]" />
            {r.cta}
          </a>
          <p class="flex items-center gap-2 text-sm text-mist">
            <Signal className="size-4 shrink-0 text-paper/60" aria-hidden="true" />
            {r.note}
          </p>
        </div>
      </div>

      <!-- Sistem kartı -->
      <div class="remote-card relative overflow-hidden rounded-[1.25rem] border border-paper/10 bg-navy shadow-[0_30px_60px_-30px_rgb(0_0_0/0.7)]">
        <!-- Kamera ekranı üst şeridi -->
        <div class="flex items-center justify-between border-b border-paper/10 px-4 py-3 font-mono text-[11px] text-paper/75 sm:text-xs" aria-hidden="true">
          <span class="flex items-center gap-2"><span class="rec size-2 rounded-full bg-coral"></span>{r.screen.label}</span>
          <span class="flex items-center gap-3">
            <span class="flex items-end gap-[2px]">
              <span class="h-1.5 w-[3px] rounded-[1px] bg-sun"></span>
              <span class="h-2 w-[3px] rounded-[1px] bg-sun"></span>
              <span class="h-2.5 w-[3px] rounded-[1px] bg-sun"></span>
              <span class="h-3 w-[3px] rounded-[1px] bg-paper/30"></span>
            </span>
            {r.screen.signal}
            <span class="flex items-center gap-1">
              <span class="relative h-2.5 w-5 rounded-[2px] border border-paper/60 p-[1px]">
                <span class="block h-full w-[86%] rounded-[1px] bg-sun"></span>
              </span>
              {r.screen.battery}
            </span>
          </span>
        </div>

        <!-- Manzara: güneş, tepeler, bağ sıraları, direkte panel + kamera, baz istasyonu -->
        <svg viewBox="0 0 480 210" class="block h-auto w-full" aria-hidden="true">
          <defs>
            <linearGradient id="rs-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--color-navy-2)"></stop>
              <stop offset="1" stop-color="var(--color-navy)"></stop>
            </linearGradient>
            <radialGradient id="rs-glow">
              <stop offset="0" stop-color="var(--color-sun)" stop-opacity="0.45"></stop>
              <stop offset="1" stop-color="var(--color-sun)" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <rect width="480" height="210" fill="url(#rs-sky)"></rect>

          <!-- Güneş -->
          <g class="sun" transform="translate(402 54)">
            <circle class="sun-glow" r="54" fill="url(#rs-glow)"></circle>
            <g class="sun-rays" stroke="var(--color-sun)" stroke-width="2.4" stroke-linecap="round">
              <line x1="0" y1="-30" x2="0" y2="-38"></line>
              <line x1="0" y1="30" x2="0" y2="38"></line>
              <line x1="-30" y1="0" x2="-38" y2="0"></line>
              <line x1="30" y1="0" x2="38" y2="0"></line>
              <line x1="21" y1="21" x2="27" y2="27"></line>
              <line x1="-21" y1="-21" x2="-27" y2="-27"></line>
              <line x1="21" y1="-21" x2="27" y2="-27"></line>
              <line x1="-21" y1="21" x2="-27" y2="27"></line>
            </g>
            <circle r="20" fill="var(--color-sun)"></circle>
          </g>

          <!-- Tepeler -->
          <path d="M0 150 C 70 112 140 118 210 138 S 360 104 480 128 L480 210 L0 210 Z" fill="var(--color-navy-3)" opacity="0.85"></path>
          <path d="M0 176 C 90 150 190 156 280 170 S 420 156 480 166 L480 210 L0 210 Z" fill="var(--color-navy-2)"></path>
          <!-- Bağ sıraları -->
          <g stroke="var(--color-teal)" stroke-opacity="0.55" stroke-width="2" stroke-linecap="round">
            <line x1="20" y1="196" x2="70" y2="176"></line>
            <line x1="48" y1="202" x2="102" y2="180"></line>
            <line x1="80" y1="206" x2="136" y2="182"></line>
            <line x1="210" y1="204" x2="262" y2="182"></line>
            <line x1="240" y1="208" x2="294" y2="184"></line>
          </g>

          <!-- Baz istasyonu -->
          <g stroke="var(--color-paper)" stroke-opacity="0.55" stroke-width="1.6" fill="none">
            <path d="M372 166 L386 92 L400 166"></path>
            <path d="M376 146 L396 146 M379 128 L393 128 M382 110 L390 110"></path>
            <path d="M376 146 L393 128 M396 146 L379 128"></path>
          </g>
          <circle cx="386" cy="90" r="3" fill="var(--color-sun)"></circle>
          <g class="tower-waves" fill="none" stroke="var(--color-sun)" stroke-width="1.6" stroke-linecap="round">
            <path class="w w1" d="M376 80 A 14 14 0 0 1 396 80"></path>
            <path class="w w2" d="M370 72 A 22 22 0 0 1 402 72"></path>
          </g>

          <!-- Kameradan baza veri akışı -->
          <path class="data" d="M196 82 C 260 50 320 62 380 88" fill="none" stroke="var(--color-sun)" stroke-width="1.6" stroke-dasharray="3 7" stroke-linecap="round"></path>

          <!-- Direk, güneş paneli, kamera -->
          <rect x="150" y="62" width="4" height="128" rx="1" fill="var(--color-paper)" fill-opacity="0.6"></rect>
          <g transform="translate(124 46) rotate(-14)">
            <rect width="54" height="30" rx="2" fill="var(--color-ink)" stroke="var(--color-teal-soft)" stroke-width="1.4"></rect>
            <path d="M18 0 V30 M36 0 V30 M0 15 H54" stroke="var(--color-teal-soft)" stroke-opacity="0.5" stroke-width="1"></path>
            <rect class="panel-shine" width="54" height="30" rx="2" fill="var(--color-sun)" opacity="0"></rect>
          </g>
          <g transform="translate(156 86)">
            <rect x="0" y="-3" width="14" height="6" fill="var(--color-paper)" fill-opacity="0.6"></rect>
            <rect x="12" y="-10" width="30" height="18" rx="5" fill="var(--color-paper)"></rect>
            <circle cx="40" cy="-1" r="6" fill="var(--color-ink)"></circle>
            <circle cx="40" cy="-1" r="2.6" fill="var(--color-teal-soft)"></circle>
            <circle class="led" cx="18" cy="-4" r="1.8" fill="var(--color-sun)"></circle>
          </g>
          <g class="cam-waves" fill="none" stroke="var(--color-sun)" stroke-width="1.6" stroke-linecap="round">
            <path class="w w1" d="M204 70 A 12 12 0 0 1 204 92"></path>
            <path class="w w2" d="M210 64 A 20 20 0 0 1 210 98"></path>
          </g>
        </svg>

        <!-- Zincir: güneş paneli → batarya → 4G kamera → telefon -->
        <ol class="relative px-5 pt-3 pb-6 sm:px-7">
          <span class="flow pointer-events-none absolute top-9 bottom-12 left-[calc(1.25rem+1.5rem-1px)] w-[2px] sm:left-[calc(1.75rem+1.5rem-1px)]" aria-hidden="true"></span>
          {
            r.steps.map((st) => (
              <li class="relative grid grid-cols-[3rem_1fr] items-center gap-4 py-2.5">
                <span class="grid size-12 place-items-center rounded-xl border border-paper/10 bg-ink text-sun">
                  <Icon name={st.icon} className="size-[1.35rem]" strokeWidth={1.8} />
                </span>
                <span>
                  <span class="block font-semibold">{st.title}</span>
                  <span class="block text-sm text-mist">{st.text}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* Güneş ışınları yavaşça döner, parıltı nefes alır */
  .sun-rays {
    transform-box: fill-box;
    transform-origin: center;
    animation: rays 18s linear infinite;
  }
  .sun-glow {
    transform-box: fill-box;
    transform-origin: center;
    animation: glow 4s ease-in-out infinite;
  }
  @keyframes rays {
    to {
      rotate: 360deg;
    }
  }
  @keyframes glow {
    50% {
      scale: 1.15;
      opacity: 0.7;
    }
  }

  /* Panel güneşi alınca hafif parlar */
  .panel-shine {
    animation: shine 4s ease-in-out infinite;
  }
  @keyframes shine {
    50% {
      opacity: 0.22;
    }
  }

  /* Kamera ve baz istasyonu sinyal dalgaları */
  .w {
    opacity: 0;
    animation: wave 2.4s ease-out infinite;
  }
  .w2 {
    animation-delay: 0.35s;
  }
  .tower-waves .w {
    animation-delay: 1.1s;
  }
  .tower-waves .w2 {
    animation-delay: 1.45s;
  }
  @keyframes wave {
    0% {
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
    }
  }

  /* Kameradan baza akan veri */
  .data {
    animation: data 1.6s linear infinite;
  }
  @keyframes data {
    to {
      stroke-dashoffset: -20;
    }
  }

  .led,
  .rec {
    animation: blink 1.6s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  /* Adımları birleştiren hat: üzerinden sarı enerji akar */
  .flow {
    background:
      linear-gradient(to bottom, transparent 0%, var(--color-sun) 50%, transparent 100%) 0 -60px / 100% 60px no-repeat,
      color-mix(in srgb, var(--color-paper) 12%, transparent);
    animation: flow 2.2s linear infinite;
  }
  @keyframes flow {
    to {
      background-position:
        0 calc(100% + 60px),
        0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sun-rays,
    .sun-glow,
    .panel-shine,
    .w,
    .data,
    .led,
    .rec,
    .flow {
      animation: none;
    }
    .w {
      opacity: 1;
    }
  }
</style>
