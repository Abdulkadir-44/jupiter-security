---
import PackagesMotion from "@/components/motion/PackagesMotion";
import { getSiteContent } from "@/lib/data";

const s = getSiteContent(Astro);
const p = s.packages;
---

<!-- Zemin neredeyse beyaz (paper): üstteki Wi-Fi bölümü krem, ikisi açık renk ama ton farkıyla ayrılsın -->
<section id="paketler" aria-labelledby="paketler-baslik" class="panel overflow-hidden bg-paper text-ink">
  <div class="wrap py-20 md:py-28">
    <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr] lg:items-end lg:gap-20">
      <h2 id="paketler-baslik" class="font-title text-balance text-[clamp(2.6rem,6vw,4.75rem)]">{p.title}</h2>
      <p class="max-w-[46ch] text-[1.1rem] text-ink-soft">{p.lead}</p>
    </div>

    <PackagesMotion client:visible={{ rootMargin: "300px" }} items={p.items} contact={s.contact} askLabel={s.ui.askPackage} includedLabel={s.ui.included} messageTemplate={s.ui.packageMessage}
      priceTemplate={p.priceTemplate}
      priceIncludes={p.priceIncludes}
      numberLocale={s.locale.numberLocale}
    />

    <div class="mt-10 flex flex-col gap-3 text-sm text-ink-soft md:flex-row md:items-center md:justify-between">
      <p>{p.priceNote}. {p.allLink}: {s.ui.soon}.</p>
      <p>
        {p.brandsLabel}:
        <span class="font-semibold text-ink">{s.brands.cctv.join(" · ")}</span>
      </p>
    </div>
  </div>
</section>
