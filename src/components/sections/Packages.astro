---
import PackagesMotion from "@/components/motion/PackagesMotion";
import { getSiteContent } from "@/lib/data";

const s = getSiteContent(Astro.currentLocale);
const p = s.packages;
---

<section id="paketler" aria-labelledby="paketler-baslik" class="panel overflow-hidden bg-cream text-ink">
  <div class="wrap py-20 md:py-28">
    <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr] lg:items-end lg:gap-20">
      <h2 id="paketler-baslik" class="font-title text-balance text-[clamp(2.6rem,6vw,4.75rem)]">{p.title}</h2>
      <p class="max-w-[46ch] text-[1.1rem] text-ink-soft">{p.lead}</p>
    </div>

    <PackagesMotion client:visible={{ rootMargin: "300px" }} items={p.items} contact={s.contact} askLabel={s.ui.askPackage} messageTemplate={s.ui.packageMessage} />

    <p class="mt-10 text-sm text-ink-soft">
      {p.priceNote}. {p.allLink}: {s.ui.soon}.
    </p>
  </div>
</section>
