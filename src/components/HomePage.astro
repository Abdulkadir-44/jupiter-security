---
// Ana sayfanın tamamı. Her dilin sayfası (src/pages/index.astro, src/pages/en/index.astro) bunu kullanır;
// bileşenler dili Astro.currentLocale ile adresten okur.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import WhatsAppFloat from "@/components/WhatsAppFloat.astro";
import Hero from "@/components/sections/Hero.astro";
import Areas from "@/components/sections/Areas.astro";
import Process from "@/components/sections/Process.astro";
import Coverage from "@/components/sections/Coverage.astro";
import Detection from "@/components/sections/Detection.astro";
import UseCases from "@/components/sections/UseCases.astro";
import Products from "@/components/sections/Products.astro";
import RemoteSites from "@/components/sections/RemoteSites.astro";
import WifiCameras from "@/components/sections/WifiCameras.astro";
import Packages from "@/components/sections/Packages.astro";
import Reviews from "@/components/sections/Reviews.astro";
import Work from "@/components/sections/Work.astro";
import Contact from "@/components/sections/Contact.astro";
import Footer from "@/components/sections/Footer.astro";
---

<BaseLayout>
  <Header />
  <main id="icerik">
    <Hero />
    <Areas />
    <Process />
    <Coverage />
    <Detection />
    <UseCases />
    <Products />
    <RemoteSites />
    <WifiCameras />
    <Packages />
    <Reviews />
    <Work />
    <Contact />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
