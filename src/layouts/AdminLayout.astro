---
/**
 * Admin paneli sayfa iskeleti (sadece Türkçe). Arama motorlarına kapalı, sitenin renkleri ve fontları.
 * Giriş adımları `auth` görünümünü kullanır: ortada tek kart. Panel düzeni (sidebar) 3. aşamada eklenecek.
 */
import "@/styles/global.css";
import Logo from "@/components/Logo.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- "referrer: no-referrer" EKLENMEZ: tarayıcı formlarda Origin'i "null" gönderir, güvenlik kontrolü her girişi reddeder -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | Jüpiter Panel</title>
  </head>
  <body class="admin-body min-h-svh bg-cream text-ink antialiased">
    <main class="grid min-h-svh place-items-center px-4 py-10">
      <div class="w-full max-w-[26rem]">
        <div class="mb-6 flex justify-center text-ink">
          <Logo spin={false} />
        </div>
        <div class="rounded-[1.5rem] bg-white p-6 shadow-[0_30px_60px_-36px_color-mix(in_srgb,var(--color-ink)_55%,transparent)] ring-1 ring-ink/10 sm:p-8">
          <slot />
        </div>
        <p class="mt-6 text-center font-mono text-[11px] tracking-[0.14em] text-ink-soft/80 uppercase">Yönetim paneli</p>
      </div>
    </main>
  </body>
</html>

<style is:global>
  /* Sitenin koyu varsayılan zemini panelde geçerli değil */
  .admin-body {
    background-color: var(--color-cream);
    color: var(--color-ink);
  }
  .admin-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .admin-input {
    display: block;
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.95rem;
    border-radius: 0.85rem;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 1rem;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 16%, transparent);
    transition: box-shadow 0.2s ease;
  }
  .admin-input:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--color-teal-ink);
  }
  .admin-input-code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.5rem;
    letter-spacing: 0.35em;
    text-align: center;
  }
  .admin-btn {
    display: inline-flex;
    width: 100%;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: var(--color-teal-ink);
    color: var(--color-paper);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .admin-btn:hover {
    background: var(--color-navy-3);
  }
  .admin-btn:focus-visible {
    outline: 2px solid var(--color-teal-ink);
    outline-offset: 3px;
  }
  .admin-btn-ghost {
    background: transparent;
    color: var(--color-ink-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 16%, transparent);
  }
  .admin-btn-ghost:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .admin-error {
    margin-bottom: 1rem;
    padding: 0.75rem 0.95rem;
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--color-coral) 10%, white);
    color: #9a2f1a;
    font-size: 0.9rem;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-coral) 30%, transparent);
  }
</style>
