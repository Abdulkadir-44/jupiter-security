---
import "@/styles/global.css";
import { defaultLocale, getSiteContent, localePath, locales } from "@/lib/data";
import { buildJsonLd } from "@/lib/schema";
// Hero sloganının yazı tipi önceden yüklenir: geç gelirse slogan boyut değiştirip hero'yu kaydırıyor (CLS).
// Sadece latin alt kümesi ("KÖR NOKTA BIRAKMIYORUZ" ve İngilizce slogan bununla çiziliyor).
import bigShouldersLatin from "@fontsource-variable/big-shoulders/files/big-shoulders-latin-opsz-normal.woff2?url";

interface Props {
  /** Sayfa başlığı (verilmezse ana sayfa SEO başlığı) */
  title?: string;
  /**
   * Yardımcı sayfa (404 vb.): her zaman noindex; canonical, dil bağlantıları,
   * paylaşım etiketleri ve işletme verisi (JSON-LD) eklenmez.
   */
  utility?: boolean;
}
const { title, utility = false } = Astro.props;

const s = getSiteContent(Astro.currentLocale);
const canonical = new URL(Astro.url.pathname, Astro.site);
// Paylaşım görseli (WhatsApp, Facebook, X vb. link önizlemesi), dile göre: public/og.jpg, public/og-en.jpg (1200x630)
const ogImage = new URL(s.seo.ogImage, Astro.site).href;
const ogAlt = s.ui.ogImageAlt;

// SEO: Geçici adreste (*.workers.dev) site Google'a KAPALI (noindex). İçerik henüz yer tutucu
// (sahte telefon/yorum) ve alan adı gelince aynı içerik iki adreste olmasın diye.
// astro.config.mjs → site gerçek alan adıyla değişince otomatik olarak "index, follow" olur.
const indexable = !Astro.site?.hostname.endsWith(".workers.dev");

// Cloudflare Web Analytics (ücretsiz, çerezsiz: çerez banner'ı gerekmez). Token gizli değil, HTML'de görünür.
// Panel: dash.cloudflare.com → Analytics & Logs → Web Analytics. Sadece build'de eklenir (npm run dev sayılmaz).
// Alan adı gelince panelde yeni adres eklenir; token değişirse burası güncellenir.
const CF_ANALYTICS_TOKEN = "541411d7560447f8bfe347d1e7433fc4";
const analytics = import.meta.env.PROD && CF_ANALYTICS_TOKEN;

// Dil sürümleri: Google'a aynı sayfanın diğer dillerini bildirir (hreflang)
const alternates = locales.map((l) => ({ lang: l, href: new URL(localePath(l), Astro.site).href }));
const xDefault = new URL(localePath(defaultLocale), Astro.site).href;
const otherOgLocales = locales.filter((l) => l !== s.locale.lang).map((l) => getSiteContent(l).locale.ogLocale);

// Yerel işletme yapılandırılmış verisi (Google için): ayrıntılar src/lib/schema.ts
const jsonLd = buildJsonLd(s, Astro.site!, canonical);
---

<!doctype html>
<html lang={s.locale.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? s.seo.title}</title>
    <link rel="preload" as="font" type="font/woff2" href={bigShouldersLatin} crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2b3828" />
    <meta name="robots" content={indexable && !utility ? "index, follow" : "noindex, nofollow"} />
    {
      !utility && (
        <Fragment>
    <meta name="description" content={s.seo.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Paylaşım önizlemesi (Open Graph: WhatsApp, Facebook, LinkedIn) */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={s.locale.ogLocale} />
    {otherOgLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:site_name" content={s.brand.fullName} />
    <meta property="og:title" content={s.seo.title} />
    <meta property="og:description" content={s.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    {/* X (Twitter) */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={s.seo.title} />
    <meta name="twitter:description" content={s.seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        </Fragment>
      )
    }
  </head>
  <body>
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-teal focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
      >{s.ui.skipToContent}</a
    >
    <slot />
    {
      analytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </body>
</html>
