---
import "@/styles/global.css";
import { getSiteContent } from "@/lib/data";

const s = getSiteContent();
const canonical = new URL(Astro.url.pathname, Astro.site);
// Paylaşım görseli (WhatsApp, Facebook, X vb. link önizlemesi): public/og.jpg, 1200x630
const ogImage = new URL("/og.jpg", Astro.site).href;
const ogAlt = "JÜPİTER Kamera Güvenlik Sistemleri: Kör nokta bırakmıyoruz";

// Yerel işletme yapılandırılmış verisi (Google için)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: s.brand.fullName,
  description: s.seo.description,
  telephone: s.contact.phoneE164,
  areaServed: s.contact.serviceAreas.map((name) => ({ "@type": "City", name })),
  address: { "@type": "PostalAddress", addressLocality: "İskenderun", addressRegion: "Hatay", addressCountry: "TR" },
  url: canonical.href,
  image: ogImage,
  logo: new URL("/apple-touch-icon.png", Astro.site).href,
  sameAs: [s.contact.instagram.url],
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{s.seo.title}</title>
    <meta name="description" content={s.seo.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#2b3828" />
    <meta name="robots" content="index, follow" />

    <!-- Paylaşım önizlemesi (Open Graph: WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={s.brand.fullName} />
    <meta property="og:title" content={s.seo.title} />
    <meta property="og:description" content={s.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <!-- X (Twitter) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={s.seo.title} />
    <meta name="twitter:description" content={s.seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-teal focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
      >{s.ui.skipToContent}</a
    >
    <slot />
  </body>
</html>
