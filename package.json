{
  "name": "jupiter-kamera",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/media.mjs && node scripts/astro.mjs dev",
    "build": "node scripts/media.mjs && node scripts/astro.mjs check && node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview",
    "deploy": "npm run build && wrangler deploy",
    "astro": "node scripts/astro.mjs",
    "stop": "node scripts/stop.mjs",
    "media": "node scripts/media.mjs",
    "db:migrate:local": "wrangler d1 migrations apply jupiter-kamera --local",
    "db:migrate:remote": "wrangler d1 migrations apply jupiter-kamera --remote",
    "db:seed:local": "tsx scripts/db-seed.ts && wrangler d1 execute jupiter-kamera --local --file db/seed.sql",
    "admin:create": "node scripts/admin.mjs create",
    "admin:reset-password": "node scripts/admin.mjs reset-password",
    "admin:reset-2fa": "node scripts/admin.mjs reset-2fa",
    "db:seed:remote": "tsx scripts/db-seed.ts && wrangler d1 execute jupiter-kamera --remote --file db/seed.sql"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/big-shoulders": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "wrangler": "^4.165.0"
  }
}
