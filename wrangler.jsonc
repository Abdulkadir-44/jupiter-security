// Cloudflare Worker ayarları. Astro'nun Cloudflare eklentisi build sırasında bunu
// dist/client/wrangler.json içine birleştirir; `npm run deploy` oradan yayınlar.
{
  "name": "jupiter-kamera",
  "compatibility_date": "2026-11-17",
  // Statik dosyalar (dist/client). Dosyası olmayan adresler Worker'a (Astro) gider: ana sayfalar orada oluşur,
  // bulunamayan adreslerde Astro 404 sayfasını (src/pages/404.astro, en/404.astro) 404 koduyla döner.
  // DİKKAT: "not_found_handling": "404-page" EKLENMEZ. O ayar tarayıcı isteklerini Worker'a hiç uğratmadan
  // 404.html ile cevaplıyor ve ana sayfa 404 görünüyordu (22.11.2026).
  "assets": {},
  // Veritabanı (Cloudflare D1, Doğu Avrupa). Kodda: import { env } from "cloudflare:workers" → env.DB
  // Tablolar: db/migrations/ (npm run db:migrate:local|remote), ilk içerik: npm run db:seed:local|remote
  // Yerel geliştirmede `npm run dev` bilgisayardaki kopyayı kullanır (.wrangler/state), canlıyı değil.
  // "İngilizceye çevir" düğmesi (Workers AI, ücretsiz günlük kota; ayrıntı src/lib/translate.ts).
  // Yerel geliştirmede de Cloudflare'in gerçek servisine gider (wrangler girişi gerekir).
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jupiter-kamera",
      "database_id": "5fdf08a9-9eee-4399-a14c-c41177fa76b2",
      "migrations_dir": "db/migrations"
    }
  ]
}
